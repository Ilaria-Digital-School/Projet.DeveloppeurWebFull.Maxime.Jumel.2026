<!doctype html>
<html lang="fr">
  <%- include("partials/head", {
    title: "Souflydev | Blog Web Development & Digital Strategy",
    description: "Découvrez les articles Souflydev sur le développement web, les applications, la performance et la stratégie digitale.",
    canonical: "https://souflyhub.dev/blog",
    keywords: "développement web, articles, tutoriels, stratégie digitale",
    language: "French"
  }) %>
  <body>
    <%- include("partials/header", { active: "blog", variant: "light" }) %>
    <main id="main-content">
      <section class="container-fluid bg-dark text-white py-5">
        <div class="container py-5">
          <h1 class="display-4 fw-bold">Blog Web Development & Digital Strategy</h1>
          <p class="lead mb-0">Conseils, tutoriels et retours d'expérience pour construire des produits numériques utiles.</p>
        </div>
      </section>

      <section class="container py-5">
        <div class="row g-4">
          <aside class="col-12 col-lg-3">
            <div class="card border-0 shadow-sm p-4">
              <h2 class="h5 fw-bold">Filtrer les articles</h2>
              <label class="form-label small text-muted" for="categoryFilter">Choisir une catégorie</label>
              <select class="form-select mb-3" id="categoryFilter" aria-label="Filtrer les articles par catégorie">
                <option value="/blog" <%= !selectedCategory ? 'selected' : '' %>>Toutes les catégories</option>
                <% (categories || []).forEach((category) => { %>
                  <option value="/blog?category=<%= encodeURIComponent(category.name) %>"
                          <%= selectedCategory === category.name ? 'selected' : '' %>>
                    <%= category.name %>
                  </option>
                <% }) %>
              </select>
              <h3 class="h6 fw-bold mt-4">Catégories</h3>
              <div class="list-group list-group-flush">
                <a class="list-group-item list-group-item-action px-0 <%= !selectedCategory ? 'active' : '' %>" href="/blog">Toutes</a>
                <% (categories || []).forEach((category) => { %>
                  <a class="list-group-item list-group-item-action px-0 <%= selectedCategory === category.name ? 'active' : '' %>"
                     href="/blog?category=<%= encodeURIComponent(category.name) %>">
                    <%= category.name %>
                  </a>
                <% }) %>
              </div>
            </div>
          </aside>

          <div class="col-12 col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <p class="text-muted mb-0">
                <% if (selectedCategory) { %>
                  Articles de la catégorie <strong><%= selectedCategory %></strong>
                <% } else { %>
                  Tous les articles
                <% } %>
              </p>
              <span class="badge text-bg-secondary"><%= (articles || []).length %> article<%= (articles || []).length !== 1 ? 's' : '' %></span>
            </div>
            <% if (locals.loadError) { %>
              <div class="alert alert-danger" role="alert">Les articles sont momentanément indisponibles.</div>
            <% } else if (!(articles || []).length) { %>
              <div class="alert alert-info" role="status">Aucun article n'est disponible pour le moment.</div>
            <% } else { %>
              <div class="row g-4">
                <% articles.forEach((article) => { %>
                  <article class="col-12 col-md-6">
                    <div class="card border-0 shadow-sm h-100 overflow-hidden">
                      <img src="<%= article.image %>" class="card-img-top" style="height: 14rem; object-fit: cover;"
                           alt="Illustration de l'article « <%= article.title %> »" loading="lazy">
                      <div class="card-body d-flex flex-column">
                        <div class="d-flex gap-2 flex-wrap mb-2">
                          <span class="badge text-bg-primary"><%= article.category %></span>
                          <time class="text-muted small" datetime="<%= article.createdAt.toISOString() %>">
                            <%= article.date %>
                          </time>
                        </div>
                        <h2 class="h4 fw-bold"><%= article.title %></h2>
                        <p class="text-muted flex-grow-1"><%= article.description %></p>
                        <button type="button" class="btn btn-dark align-self-start"
                                data-bs-toggle="modal" data-bs-target="#blogArticleModal"
                                data-article-title="<%= article.title %>"
                                data-article-image="<%= article.image %>"
                                data-article-description="<%= article.description %>"
                                data-article-category="<%= article.category %>"
                                data-article-date="<%= article.date %>">
                          Lire l'article
                        </button>
                      </div>
                    </div>
                  </article>
                <% }) %>
              </div>
            <% } %>
          </div>
        </div>
      </section>
    </main>
    <%- include("partials/footer") %>

    <div class="modal fade" id="blogArticleModal" tabindex="-1" aria-labelledby="blogArticleModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <div>
              <span class="badge text-bg-primary mb-2" id="blogArticleCategory"></span>
              <h2 class="modal-title h4 mb-0" id="blogArticleModalLabel"></h2>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
          </div>
          <div class="modal-body">
            <img id="blogArticleImage" class="img-fluid rounded mb-4 w-100" alt="">
            <p id="blogArticleDescription" class="fs-5"></p>
            <time id="blogArticleDate" class="text-muted"></time>
          </div>
        </div>
      </div>
    </div>
    <script src="/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"></script>
    <script nonce="<%= locals.cspNonce || '' %>">
      document.getElementById("categoryFilter")?.addEventListener("change", (event) => {
        const destination = event.target.value;
        if (destination) window.location.assign(destination);
      });

      document.getElementById("blogArticleModal")?.addEventListener("show.bs.modal", (event) => {
        const trigger = event.relatedTarget;
        if (!trigger) return;
        const title = trigger.dataset.articleTitle || "Article";
        document.getElementById("blogArticleModalLabel").textContent = title;
        document.getElementById("blogArticleCategory").textContent = trigger.dataset.articleCategory || "";
        document.getElementById("blogArticleImage").src = trigger.dataset.articleImage || "";
        document.getElementById("blogArticleImage").alt = `Illustration de l'article « ${title} »`;
        document.getElementById("blogArticleDescription").textContent = trigger.dataset.articleDescription || "";
        document.getElementById("blogArticleDate").textContent = trigger.dataset.articleDate
          ? `Publié le ${trigger.dataset.articleDate}` : "";
      });
    </script>
    <%- include("partials/cookie-consent") %>
  </body>
</html>
