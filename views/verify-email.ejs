<!doctype html>
<html lang="fr">
<%- include("partials/head", { title: "Vérification du compte | Souflydev", canonical: "https://soulfyhub.fr/verify-email", social: false, styles: ["/css/_login.css"], language: "French", vendor: false }) %>
<body class="bg-black d-flex align-items-center justify-content-center">
    <main class="login-container">
        <section class="login-card text-center">
            <img src="/images/upload/soulfydev.webp" class="brand-logo mb-3" alt="Soulfydev Logo">
            <h1 class="h3 text-light mb-3"><%= success ? "Compte activé" : "Vérification impossible" %></h1>
            <p class="text-light"><%= message %></p>
            <a href="<%= success ? '/login' : '/register' %>" class="back-link">
                <%= success ? "Se connecter" : "Retour à l'inscription" %>
            </a>
        </section>
    </main>
    <%- include("partials/cookie-consent") %>
</body>
</html>
