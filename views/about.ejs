            <input type="text" class="form-control bg-transparent border-1 border-dark" name="email" id="email"
              placeholder="Email">
          </div>

          <input type="text" class="form-control bg-transparent border-1 border-dark" name="subject" id="subject"
            placeholder="Subject">
          <textarea class="form-control bg-transparent border-1 border-dark" name="message" id="message"
            placeholder="Message" rows="4"></textarea>

          <div>
            <button type="submit" class="btn btn-dark px-4">Send</button>
          </div>
        </form>
      </div>

    </div>
