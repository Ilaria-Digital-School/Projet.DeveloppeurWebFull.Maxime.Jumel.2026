<!doctype html>
<html lang="en">
  <%- include("partials/head", { title: "Souflydev | Login", description: "Log in to your Souflydev account to manage your web and mobile projects dashboard.", canonical: "https://soulfyhub.fr/login", keywords: "Web and mobile application developer", styles: ["/css/_login.css"], language: "French" }) %>
  <body class="bg-black d-flex align-items-center justify-content-center">
    <div class="login-container">
      <!-- Back Link -->
      <div class="mb-4">
        <a href="/" class="back-link">
          <i class="bi bi-arrow-left"></i> Back to Home
        </a>
      </div>

      <!-- Card wrapper -->
      <main class="login-card text-center">
        <div class="mb-4">
          <img
            src="/images/upload/soulfydev.webp"
            class="brand-logo mb-3"
            alt="Soulfydev Logo">
          <h1 class="h3 font-weight-bold text-light mb-1">Account Login - Souflydev Web & Mobile Solutions</h1>
          <p class="text-light small pt-4">
            Accédez à votre tableau de bord Soulfydev
          </p>
          <div>
            <a href="/register" class="back-link">
              <i class="bi bi-arrow-left"></i> Inscrivez-vous
            </a>
          </div>
        </div>

        <!-- Message d'erreur / succès -->
        <div id="message-container" class="mb-3" style="min-height: 24px;"></div>

        <!-- Login Form -->
        <form id="loginForm">
          <div class="mb-3 text-start">
            <label
              for="inputEmail"
              class="form-label text-light small font-weight-bold"
              >Adresse Email</label
            >
            <input
              type="email"
              class="form-control form-control-custom"
              id="inputEmail"
              placeholder="nom@exemple.com"
              aria-label="Adresse Email"
              autocomplete="email"
              required>
          </div>
          <div class="mb-4 text-start">
            <label
              for="inputPassword"
              class="form-label text-light small font-weight-bold"
              >Mot de passe</label
            >
            <input
              type="password"
              class="form-control form-control-custom"
              id="inputPassword"
              placeholder="••••••••"
              aria-label="Mot de passe"
              autocomplete="current-password"
              required>
          </div>
          <button
            type="submit"
            id="btnSubmit"
            class="btn btn-login btn-primary w-100 text-light uppercase"
          >
            Se connecter
          </button>
        </form>
      </main>
    </div>

    <!-- Bootstrap Bundle JS -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>

    <script src="/js/login.js"></script>
      <%- include("partials/cookie-consent") %>
</body>
</html>
