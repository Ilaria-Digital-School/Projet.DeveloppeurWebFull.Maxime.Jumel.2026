<!doctype html>
<html lang="fr">
<%- include("partials/head", { title: "Prestations | Souflydev", description: "Découvrez les prestations de développement web et mobile proposées par Souflydev.", canonical: "https://soulfyhub.fr/services", keywords: "développement web, application mobile, prestations", styles: ["/css/style.css"], language: "French" }) %>
<body>
<%- include("partials/header", { active: "" }) %>

<main class="container py-5">
  <header class="mb-4">
    <h1 class="h3 mb-1">Nos prestations</h1>
    <p class="text-secondary mb-0">Les services disponibles, organisés par catégorie.</p>
  </header>

  <% if (locals.loadError) { %>
    <div class="alert alert-danger">Impossible de charger les prestations pour le moment.</div>
  <% } %>

  <% if (!locals.categories || locals.categories.length === 0) { %>
    <p class="text-secondary">Aucune prestation n'est publiée pour le moment.</p>
  <% } %>

  <div class="row g-4">
    <% (locals.categories || []).forEach((category) => { %>
      <div class="col-12">
        <section class="card h-100 border-0 shadow-sm">
          <div class="card-body p-4">
            <div class="d-flex align-items-start gap-3 mb-3">
              <span class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                    style="width: 3rem; height: 3rem; background: rgba(99, 102, 241, 0.12);">
                <i class="bi <%= category.icon %> fs-5" style="color: #818cf8;" aria-hidden="true"></i>
              </span>
              <div>
                <h2 class="h5 mb-1"><%= category.name %></h2>
                <p class="text-secondary small mb-0"><%= category.description %></p>
              </div>
            </div>

            <% if (category.services.length === 0) { %>
              <p class="text-secondary small mb-0">Aucun service dans cette catégorie.</p>
            <% } else { %>
              <ul class="list-group list-group-flush">
                <% category.services.forEach((service) => { %>
                  <li class="list-group-item px-0">
                    <p class="fw-semibold mb-1"><%= service.name %></p>
                    <p class="text-secondary small mb-0"><%= service.description %></p>
                  </li>
                <% }) %>
              </ul>
            <% } %>
          </div>
        </section>
      </div>
    <% }) %>
  </div>
</main>

<% if (locals.isManager) { %>
  <div class="container pb-5">
    <button type="button" class="btn btn-outline-secondary btn-sm"
            data-bs-toggle="modal" data-bs-target="#modalServiceAdmin">
      <i class="bi bi-sliders me-1" aria-hidden="true"></i>Gérer les prestations
    </button>
  </div>

  <%- include("modals/Service_admin") %>
  <%- include("modals/Category_edit") %>
  <%- include("modals/Service_edit") %>
<% } %>

<%- include("partials/footer") %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"></script>
<% if (locals.isManager) { %>
<script src="/js/services-admin.js"></script>
<% } %>
</body>
</html>