          </div>

          <!-- Articles Grid -->
          <% if (articles && articles.length> 0) { %>
            <div class="row g-4">
              <% articles.forEach((article)=> { %>
                <div class="col-12 col-md-6 col-lg-4">
                  <div class="card h-100 border-0 shadow-sm rounded-4 position-relative overflow-hidden"
                    style="min-height: 20rem;">

                    <!-- Image -->
                    <img src="<%= article.image %>"
                      class="card-img img-fluid w-100 h-100 position-absolute top-0 start-0" alt="<%= article.title %>">

                    <!-- Overlay -->
                    <div class="card-body d-flex flex-column position-relative z-2 h-100 p-4 
                bg-black bg-opacity-75 text-white justify-content-center">

                      <!-- Badges -->
                      <div class="d-flex gap-2 mb-3 flex-wrap">
                        <span class="badge bg-secondary">
                          <%= article.date %>
                        </span>
                        <span class="badge bg-secondary">
                          <%= article.category %>
                        </span>
                      </div>

                      <!-- Titre -->
                      <h3 class="card-title h5 fw-bold mb-3">
                        <%= article.title %>
                      </h3>

                      <!-- Description -->
                      <p class="card-text mb-4">
                        <%= article.description %>
                      </p>

