      <section class="container-fluid py-5 mb-5 mx-auto">
        <div class="project-title text-center mb-5">
          <h2 class="fw-bold display-6">Discover our selected projects</h2>
        </div>

        <% if (projects && projects.length> 0) { %>
          <!-- Carousel avec projets -->
          <div id="cardsCarousel" class="carousel slide cards-carousel" data-bs-ride="carousel">

            <!-- Slides -->
            <div class="carousel-inner">
              <% projects.forEach((project, index)=> { %>
                <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                  <div class="card h-100 border-0 shadow-sm rounded-4">
                    <img src="<%= assetUrl(project.imageUrl) %>" class="card-img-top" alt="<%= project.title %>">
                    <div class="card-body p-4">
                      <h3 class="card-title h5 fw-bold">
                        <%= project.title %>
                      </h3>
                      <p class="card-text text-muted">
                        <%= project.description %>
                      </p>
                      <button type="button" class="btn btn-primary" data-bs-toggle="modal"
                        data-bs-target="#projectModal" data-project-title="<%= project.title %>"
                        data-project-image="<%= assetUrl(project.imageUrl) %>"
                        data-project-description="<%= project.description %>">
                        View Project
                      </button>
                    </div>
                  </div>
                </div>
                <% }); %>
            </div>

            <!-- Indicateurs (générés dynamiquement) -->
            <div class="carousel-indicators">
              <% projects.forEach((project, index)=> { %>
                <button type="button" data-bs-target="#cardsCarousel" data-bs-slide-to="<%= index %>"
                  class="<%= index === 0 ? 'active' : '' %>" aria-label="Project <%= index + 1 %>">
                </button>
                <% }); %>
            </div>

            <!-- Contrôles Prev / Next -->
            <button class="carousel-control-prev" type="button" data-bs-target="#cardsCarousel" data-bs-slide="prev">
              <span class="carousel-control-prev-icon" aria-hidden="true"></span>
              <span class="visually-hidden">Précédent</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#cardsCarousel" data-bs-slide="next">
              <span class="carousel-control-next-icon" aria-hidden="true"></span>
              <span class="visually-hidden">Suivant</span>
            </button>

          </div>

          <% } else { %>
            <!-- Message aucun projet -->
            <div class="text-center">
              <div class="card h-100 border-0 shadow-sm rounded-4 mx-auto" style="max-width: 500px;">
                <div class="card-body p-4">
                  <h3 class="card-title h5 fw-bold">No Projects Available</h3>
                  <p class="card-text text-muted">Currently, there are no projects to display. Please check back later.
                  </p>
                </div>
              </div>
            </div>
            <% } %>

      </section>

