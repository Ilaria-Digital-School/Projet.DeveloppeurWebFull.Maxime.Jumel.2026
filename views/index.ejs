    <%- include("partials/footer") %>




      <!-- modal recource projet -->
      <div class="modal fade" id="projectModal" tabindex="-1" aria-labelledby="projectModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="projectModalLabel">Project Title</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <img src="/images/img-random/pexels-william-fortunato-6140477.webp" alt="" class="img-fluid mb-3"
                id="projectModalImage">
              <p id="projectModalDescription">
                Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et
                dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip
                ex ea commodo consequat.
              </p>
            </div>
          </div>
        </div>
      </div>
      <!-- modal article -->
      <div class="modal fade" id="articleModal" tabindex="-1" aria-labelledby="articleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
          <div class="modal-content">
            <div class="modal-header">
              <div>
                <span class="badge text-bg-primary mb-2" id="articleModalCategory"></span>
                <h2 class="modal-title h4 mb-0" id="articleModalLabel"></h2>
              </div>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
              <img src="" alt="" class="img-fluid rounded-3 mb-4 w-100"
                style="max-height: 26rem; object-fit: cover;"
                id="articleModalImage">
              <p id="articleModalDescription" class="fs-5 mb-4"></p>
              <p class="text-muted mb-0">
                <i class="bi bi-calendar3 me-2" aria-hidden="true"></i>
                <span id="articleModalDate"></span>
              </p>
            </div>
          </div>
        </div>
      </div>

      <script src="/js/recherche.js"></script>
      <script src="/js/script.js"></script>
      <script src="/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
      <script src="/js/main.js"></script>
      <script nonce="<%= locals.cspNonce || '' %>">
        document.getElementById("articleModal")?.addEventListener("show.bs.modal", (event) => {
          const trigger = event.relatedTarget;
          if (!trigger) return;

          const title = trigger.dataset.articleTitle || "Article";
          const image = trigger.dataset.articleImage || "";
          const description = trigger.dataset.articleDescription || "";
          const category = trigger.dataset.articleCategory || "";
          const rawDate = trigger.dataset.articleDate || "";
          const parsedDate = rawDate ? new Date(rawDate) : null;
          const date = parsedDate && !Number.isNaN(parsedDate.getTime())
            ? parsedDate.toLocaleDateString("fr-FR", { dateStyle: "long" })
            : rawDate;

          document.getElementById("articleModalLabel").textContent = title;
          document.getElementById("articleModalImage").src = image;
          document.getElementById("articleModalImage").alt = `Illustration de l'article « ${title} »`;
          document.getElementById("articleModalDescription").textContent = description;
          document.getElementById("articleModalCategory").textContent = category;
          document.getElementById("articleModalDate").textContent = date ? `Publié le ${date}` : "";
        });
      </script>
      <%- include("partials/cookie-consent") %>
  </body>

