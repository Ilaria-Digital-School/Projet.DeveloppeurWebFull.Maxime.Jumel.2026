<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Souflydev | <%= user.pseudo %></title>
    <!-- SEO Optimization -->
    <meta name="description" content="Access your Souflydev project dashboard to manage web development projects, client requests, and metrics.">
    <link rel="canonical" href="https://backend.soulfyhub.fr/dashboard">
    <meta name="geo.region" content="FR-IDF">
    <meta name="geo.placename" content="Coulommiers">
    <meta name="geo.position" content="48.8096;3.0822">
    <meta name="ICBM" content="48.8096, 3.0822">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <!-- IMPORT ICON BOOTSTRAP -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.3/font/bootstrap-icons.min.css">
    <!-- IMPORT FONT AWESOME -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <!-- import css dashboard -->
    <link rel="stylesheet" href="/css/_dashboard.css">
    
</head>
<body class="d-flex flex-column flex-md-row" style="height: 100vh; overflow: hidden; background-color: #f8f9fa;">
    
    <!-- slid bar section  -->
    <header class="border-end border-secondary border-opacity-25" style="background-color: #181a1bff;">
        <!-- Top navbar for mobile only -->
        <div class="navbar navbar-dark bg-dark d-md-none px-3 py-2 w-100 d-flex justify-content-between align-items-center">
            <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarOffcanvas" aria-controls="sidebarOffcanvas">
                <i class="fa-solid fa-bars text-white"></i>
            </button>
            <span class="navbar-brand mb-0 h1 fs-5 fw-bold text-white">The BPT</span>
            <div style="width: 1.875rem;"></div> <!-- Spacer to align logo -->
        </div>

        <!-- Sidebar offcanvas/desktop container -->
        <div class="offcanvas-md offcanvas-start sidebar text-white border-0" tabindex="-1" id="sidebarOffcanvas" aria-labelledby="sidebarOffcanvasLabel" role="region">
            <div class="d-flex flex-column h-100" style="background-color: #181a1bff;">
                <!-- Offcanvas header (visible on mobile only) -->
                <div class="offcanvas-header d-md-none p-4 pb-2 text-white">
                    <h2 class="offcanvas-title h5 fw-bold" id="sidebarOffcanvasLabel">The BPT</h2>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#sidebarOffcanvas" aria-label="Close"></button>
                </div>
                
                <div class="items-center w-100 flex-grow-1 position-relative d-flex flex-column justify-content-between">
                    <div class="w-100">
                        <!-- Desktop Logo -->
                        <div class="logo p-4 d-none d-md-flex align-items-center">
                            <i class="fa-solid fa-bars text-white fs-5"></i>
                            <span class="text-white mx-2 fw-bold">The Souflyhub.fr</span>
                        </div>
                        
                        <!-- User Card -->
                        <div class="w-100 d-flex align-items-center justify-content-center py-3">
                            <div class="user-info text-center">
                                <img src="<%= user.avatar || 'https://i.pravatar.cc/150' %>" alt="Avatar de <%= user.pseudo %>" class="rounded-circle border border-2 border-secondary shadow-sm" style="width: 5rem; height: 5rem; object-fit: cover;">
                                <p class="text-white mt-2 mb-0 fw-semibold"><%= user.pseudo %></p>
                                <span class="text-muted text-small d-block" style="font-size: 0.75rem;"><%= user.role %></span>
                            </div>
                        </div>

                        <!-- Sidebar Nav -->
                        <div class="nav-links p-2">
                            <nav class="row mx-0">
                                <div class="col-12 px-2">
                                    <ul class="nav flex-column nav-items">
                                        <li class="nav-item mb-2">
                                            <a href="/" class="nav-link text-white d-flex align-items-center gap-2"><i class="fa-solid fa-house"></i>Home</a>
                                        </li>
                                        <% if (user && (user.role === 'admin' || user.role === 'developper')) { %>
                                        <li class="nav-item mb-2">
                                            <a href="#" class="nav-link text-white d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#modalProducts"><i class="fa-solid fa-box"></i>Products</a>
                                        </li>
                                        <li class="nav-item mb-2">
                                            <a href="#" class="nav-link text-white d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#modalAccountProfile"><i class="fa-solid fa-user"></i>Accounts</a>
                                        </li>
                                        <li class="nav-item mb-2">
                                            <a href="#" class="nav-link text-white d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#modalOrdersHistory"><i class="fa-solid fa-clock-rotate-left"></i>Order History</a>
                                        </li>
                                        <% } else { %>
                                        <li class="nav-item mb-2">
                                            <a href="#" class="nav-link text-white d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#modalOrdersHistory"><i class="fa-solid fa-bag-shopping"></i>Mes Commandes</a>
                                        </li>
                                        <li class="nav-item mb-2">
                                            <a href="/client/ticket" class="nav-link text-white d-flex align-items-center gap-2"><i class="fa-solid fa-comments"></i>Support</a>
                                        </li>
                                        <% } %>
                                    </ul>
                                </div>
                            </nav>
                        </div>
                    </div>
                    
                    <!-- Bottom dropup profile menu -->
                    <div class="w-100 p-3 border-top border-secondary border-opacity-25 mt-auto">
                        <div class="dropup">
                            <a href="#" class="d-flex align-items-center text-white text-decoration-none" id="profileDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <img src="<%= user.avatar || 'https://i.pravatar.cc/150' %>" alt="Avatar de <%= user.pseudo %>" width="32" height="32" class="rounded-circle me-2 border border-secondary" style="object-fit: cover;">
                                <div class="flex-grow-1 min-w-0 me-2">
                                    <span class="d-block text-truncate fw-semibold text-light" style="font-size: 0.85rem;"><%= user.pseudo %></span>
                                    <small class="text-muted d-block text-truncate" style="font-size: 0.7rem;"><%= user.role %></small>
                                </div>
                                <i class="fa-solid fa-ellipsis-vertical text-muted fs-6"></i>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark shadow border-secondary border-opacity-50 w-100" aria-labelledby="profileDropdown">
                                <li>
                                    <a class="dropdown-item d-flex align-items-center py-2" href="#" data-bs-toggle="modal" data-bs-target="#modalAccountProfile">
                                        <i class="fa-solid fa-user me-2 text-muted" style="width: 1rem;"></i>
                                        <span style="font-size: 0.85rem;">Profile</span>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center py-2" href="#" data-bs-toggle="modal" data-bs-target="#modalAccountProfile">
                                        <i class="fa-solid fa-gear me-2 text-muted" style="width: 1rem;"></i>
                                        <span style="font-size: 0.85rem;">Profile Settings</span>
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider border-secondary border-opacity-50"></li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center py-2 text-danger" href="/logout">
                                        <i class="fa-solid fa-right-from-bracket me-2" style="width: 1rem;"></i>
                                        <span style="font-size: 0.85rem;">Déconnexion</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>
    
    <main class="flex-grow-1 p-4">
        <div class="container-fluid">
            <% if (user && (user.role === 'admin' || user.role === 'developper')) { %>
            <!-- ============================================== -->
            <!--                  ADMIN VIEW                    -->
            <!-- ============================================== -->
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 pb-2 border-bottom border-secondary border-opacity-10 gap-3">
                <div>
                    <h1 class="h3 mb-1 fw-bold text-dark">Souflydev Client & Project Management Dashboard</h1>
                    <p class="text-muted mb-0" style="font-size: 0.9rem;">Aperçu général et statistiques de votre activité administrateur.</p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-2">
                        <i class="fa-solid fa-calendar"></i>
                        <span>Derniers 30 jours</span>
                    </button>
                    <button class="btn btn-primary btn-sm d-flex align-items-center gap-2" style="background-color: #4f46e5; border-color: #4f46e5;" data-bs-toggle="modal" data-bs-target="#modalProjects">
                        <i class="fa-solid fa-plus"></i>
                        <span>Nouveau projet</span>
                    </button>
                </div>
            </div>

            <!-- Stats grid (Admin) -->
            <div class="row g-4 mb-4">
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card border-0 shadow-sm h-100" style="border-radius: 0.75rem;">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-3" style="width: 3rem; height: 3rem; display: flex; align-items: center; justify-content: center;">
                                    <i class="fa-solid fa-euro-sign fs-5"></i>
                                </div>
                                <span class="badge bg-success bg-opacity-10 text-success fw-medium">Total</span>
                            </div>
                            <span class="text-muted d-block mb-1" style="font-size: 0.85rem; font-weight: 500;">Chiffre d'Affaires</span>
                            <p class="fs-3 fw-bold mb-0 text-dark"><%= (stats.totalRevenue ? Number(stats.totalRevenue).toLocaleString('fr-FR', { minimumFractionDigits: 2 }) : '0,00') %> €</p>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card border-0 shadow-sm h-100" style="border-radius: 0.75rem;">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="bg-info bg-opacity-10 text-info p-3 rounded-3" style="width: 3rem; height: 3rem; display: flex; align-items: center; justify-content: center;">
                                    <i class="fa-solid fa-users fs-5"></i>
                                </div>
                                <span class="badge bg-info bg-opacity-10 text-info fw-medium">Inscrits</span>
                            </div>
                            <span class="text-muted d-block mb-1" style="font-size: 0.85rem; font-weight: 500;">Membres Totaux</span>
                            <p class="fs-3 fw-bold mb-0 text-dark"><%= stats.totalMembers || 0 %></p>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card border-0 shadow-sm h-100" style="border-radius: 0.75rem;">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="bg-success bg-opacity-10 text-success p-3 rounded-3" style="width: 3rem; height: 3rem; display: flex; align-items: center; justify-content: center;">
                                    <i class="fa-solid fa-shopping-cart fs-5"></i>
                                </div>
                                <span class="badge bg-success bg-opacity-10 text-success fw-medium">Total</span>
                            </div>
                            <span class="text-muted d-block mb-1" style="font-size: 0.85rem; font-weight: 500;">Commandes Totales</span>
                            <p class="fs-3 fw-bold mb-0 text-dark"><%= stats.totalOrders || 0 %></p>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card border-0 shadow-sm h-100" style="border-radius: 0.75rem;">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-3" style="width: 3rem; height: 3rem; display: flex; align-items: center; justify-content: center;">
                                    <i class="fa-solid fa-spinner fs-5"></i>
                                </div>
                                <span class="badge bg-warning bg-opacity-10 text-warning fw-medium">Actives</span>
                            </div>
                            <span class="text-muted d-block mb-1" style="font-size: 0.85rem; font-weight: 500;">Commandes En Cours</span>
                            <p class="fs-3 fw-bold mb-0 text-dark"><%= stats.activeOrders || 0 %></p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Orders Table & Recent Activity (Admin) -->
            <div class="row g-4 mb-4">
                <div class="col-12 col-xl-8">
                    <div class="card border-0 shadow-sm p-4" style="border-radius: 0.75rem;">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h2 class="h5 fw-bold text-dark mb-0">Dernières Commandes</h2>
                            <div class="d-flex align-items-center gap-2">
                                <button class="btn btn-primary btn-sm d-flex align-items-center gap-1" style="background-color: #4f46e5; border-color: #4f46e5;" data-bs-toggle="modal" data-bs-target="#modalAddOrder">
                                    <i class="fa-solid fa-plus" style="font-size: 0.75rem;"></i>
                                    <span>Ajouter</span>
                                </button>
                                <a href="#" class="btn btn-link btn-sm text-decoration-none text-primary p-0 ms-2">Voir tout</a>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr style="font-size: 0.85rem; color: #6b7280;">
                                        <th scope="col">Commande ID</th>
                                        <th scope="col">Produit</th>
                                        <th scope="col">Client</th>
                                        <th scope="col">Date</th>
                                        <th scope="col">Statut</th>
                                        <th scope="col">Total</th>
                                        <th scope="col" class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody style="font-size: 0.9rem;">
                                    <% if (typeof orders !== 'undefined' && orders.length > 0) { %>
                                        <% orders.forEach(order => { %>
                                            <tr>
                                                <td class="fw-semibold">#ORD-<%= order.id %></td>
                                                <td><%= order.name %></td>
                                                <td><%= order.client_name %></td>
                                                <td class="text-muted"><%= new Date(order.created_at || Date.now()).toLocaleDateString('fr-FR') %></td>
                                                <td>
                                                    <% if (order.status === 'Complété') { %>
                                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2.5 py-1">Complété</span>
                                                    <% } else if (order.status === 'En cours') { %>
                                                        <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-2.5 py-1">En cours</span>
                                                    <% } else if (order.status === 'Annulé') { %>
                                                        <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-2.5 py-1">Annulé</span>
                                                    <% } else { %>
                                                        <span class="badge bg-info bg-opacity-10 text-info rounded-pill px-2.5 py-1"><%= order.status %></span>
                                                    <% } %>
                                                </td>
                                                <td class="fw-semibold"><%= Number(order.total_price || 0).toLocaleString('fr-FR', { minimumFractionDigits: 2 }) %> €</td>
                                                <td class="text-end">
                                                    <div class="d-flex justify-content-end gap-1">
                                                        <button class="btn btn-outline-danger btn-sm px-2 py-1" title="Supprimer" data-bs-toggle="modal" data-bs-target="#modalDeleteOrder">
                                                            <i class="fa-solid fa-trash" style="font-size: 0.75rem;"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="7" class="text-center text-muted py-4">Aucune commande enregistrée pour le moment.</td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                
                <div class="col-12 col-xl-4">
                    <div class="card border-0 shadow-sm p-4 h-100" style="border-radius: 0.75rem;">
                        <h2 class="h5 fw-bold text-dark mb-4">Activité Récente</h2>
                        <div class="position-relative ps-4 border-start border-light border-2" style="border-left-style: dashed !important;">
                            <div class="mb-4 position-relative">
                                <span class="position-absolute start-0 top-0 translate-middle bg-primary rounded-circle" style="width: 0.625rem; height: 0.625rem; margin-left: -1.0625rem; margin-top: 0.375rem;"></span>
                                <small class="text-muted d-block" style="font-size: 0.75rem;">14:32 - Aujourd'hui</small>
                                <span class="fw-semibold text-dark" style="font-size: 0.85rem;">Mise à jour du système effectuée</span>
                                <p class="text-muted mb-0" style="font-size: 0.8rem;">La version v2.4.1 a été déployée avec succès.</p>
                            </div>
                            <div class="mb-4 position-relative">
                                <span class="position-absolute start-0 top-0 translate-middle bg-success rounded-circle" style="width: 0.625rem; height: 0.625rem; margin-left: -1.0625rem; margin-top: 0.375rem;"></span>
                                <small class="text-muted d-block" style="font-size: 0.75rem;">11:15 - Aujourd'hui</small>
                                <span class="fw-semibold text-dark" style="font-size: 0.85rem;">Nouveau produit ajouté</span>
                                <p class="text-muted mb-0" style="font-size: 0.8rem;">Le produit "Apple Watch Ultra 2" a été ajouté au catalogue.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Contact / Tickets section (Admin) -->
            <!-- Contact / Tickets section (Admin) -->
            <div class="row g-4 mb-4">
                <div class="col-12">
                    <div class="card border-0 shadow-sm p-4 animate-on-hover" style="border-radius: 0.75rem;">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h2 class="h5 fw-bold text-dark mb-0">
                                <i class="fa-solid fa-headset me-2 text-primary"></i>Tickets de Support 
                                <% if (typeof tickets !== 'undefined' && tickets.length > 0) { %>
                                    <span class="badge bg-danger ms-2" style="font-size:0.75rem;"><%= tickets.filter(t => t.status === 'open' || t.status === 'pending').length %> en attente</span>
                                <% } %>
                            </h2>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr style="font-size: 0.85rem; color: #6b7280;">
                                        <th scope="col">Client</th>
                                        <th scope="col">Email</th>
                                        <th scope="col">Sujet</th>
                                        <th scope="col">Date</th>
                                        <th scope="col">Statut</th>
                                        <th scope="col" class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody style="font-size: 0.9rem;">
                                    <% if (typeof tickets !== 'undefined' && tickets.length > 0) { %>
                                        <% tickets.forEach(ticket => { %>
                                            <tr>
                                                <td class="fw-semibold text-dark"><%= ticket.client_name || 'Anonyme' %></td>
                                                <td class="text-muted small"><%= ticket.client_email %></td>
                                                <td class="fw-medium"><%= ticket.title || ticket.subject %></td>
                                                <td class="text-muted small"><%= new Date(ticket.createdAt || ticket.created_at).toLocaleDateString('fr-FR') %></td>
                                                <td>
                                                    <% if (ticket.status === 'repondu') { %>
                                                        <span class="badge bg-info bg-opacity-10 text-info rounded-pill px-2.5 py-1">Répondu</span>
                                                    <% } else if (ticket.status === 'pending') { %>
                                                        <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-2.5 py-1">En attente</span>
                                                    <% } else if (ticket.status === 'close') { %>
                                                        <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-2.5 py-1">Fermé</span>
                                                    <% } else { %>
                                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2.5 py-1">Ouvert</span>
                                                    <% } %>
                                                </td>
                                                <td class="text-end">
                                                    <div class="d-flex justify-content-end gap-1">
                                                        <button class="btn btn-outline-primary btn-sm px-2 py-1" title="Voir et Répondre" data-bs-toggle="modal" data-bs-target="#modalAdminTicket-<%= ticket._id %>">
                                                            <i class="fa-solid fa-message" style="font-size: 0.75rem;"></i>
                                                        </button>
                                                        <a href="/api/admin/tickets/<%= ticket.userId %>/<%= ticket._id %>/delete" onclick="return confirm('Supprimer ce ticket ?');" class="btn btn-outline-danger btn-sm px-2 py-1" title="Supprimer">
                                                            <i class="fa-solid fa-trash" style="font-size: 0.75rem;"></i>
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>

                                            <!-- Modale Admin pour ce ticket -->
                                            <div class="modal fade" id="modalAdminTicket-<%= ticket._id %>" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered modal-lg">
                                                    <div class="modal-content border-0 shadow">
                                                        <div class="modal-header border-bottom bg-light">
                                                            <div>
                                                                <h5 class="modal-title fw-bold mb-0"><%= ticket.title %></h5>
                                                                <small class="text-muted">Client : <strong><%= ticket.client_name %></strong> (<%= ticket.client_email %>) - <%= new Date(ticket.createdAt).toLocaleString('fr-FR') %></small>
                                                            </div>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body p-4">
                                                            <!-- Message initial du client -->
                                                            <div class="mb-4">
                                                                <label class="form-label text-muted small fw-bold text-uppercase">Demande initiale</label>
                                                                <div class="p-3 bg-light rounded-3 border" style="white-space: pre-wrap; font-size: 0.95rem;"><%= ticket.message %></div>
                                                            </div>

                                                            <!-- Historique des réponses -->
                                                            <% if (ticket.replies && ticket.replies.length > 0) { %>
                                                                <div class="mb-4">
                                                                    <label class="form-label text-muted small fw-bold text-uppercase">Historique de la conversation (<%= ticket.replies.length %>)</label>
                                                                    <div class="d-flex flex-column gap-2">
                                                                        <% ticket.replies.forEach(reply => { %>
                                                                            <div class="p-3 rounded-3 border <%= reply.role === 'admin' || reply.role === 'developper' ? 'bg-primary bg-opacity-10 border-primary border-opacity-25 ms-4' : 'bg-light me-4' %>">
                                                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                                                    <span class="small fw-bold <%= reply.role === 'admin' || reply.role === 'developper' ? 'text-primary' : 'text-dark' %>">
                                                                                        <%= reply.sender %> <%= reply.role === 'admin' || reply.role === 'developper' ? '(Admin/Support)' : '(Client)' %>
                                                                                    </span>
                                                                                    <small class="text-muted" style="font-size: 0.75rem;"><%= new Date(reply.createdAt).toLocaleString('fr-FR') %></small>
                                                                                </div>
                                                                                <p class="mb-0 small" style="white-space: pre-wrap;"><%= reply.message %></p>
                                                                            </div>
                                                                        <% }); %>
                                                                    </div>
                                                                </div>
                                                            <% } %>

                                                            <!-- Formulaire Réponse Admin -->
                                                            <hr class="my-4">
                                                            <form action="/api/admin/tickets/<%= ticket.userId %>/<%= ticket._id %>/reply" method="POST">
                                                                <div class="mb-3">
                                                                    <label class="form-label fw-semibold" style="font-size: 0.9rem;">Répondre au client</label>
                                                                    <textarea class="form-control" name="replyMessage" rows="3" placeholder="Tapez votre réponse de support ici..." required></textarea>
                                                                </div>
                                                                <div class="row align-items-end g-3">
                                                                    <div class="col-md-6">
                                                                        <label class="form-label small text-muted">Statut après réponse</label>
                                                                        <select class="form-select form-select-sm" name="status">
                                                                            <option value="repondu" selected>Répondu</option>
                                                                            <option value="open">Ouvert</option>
                                                                            <option value="pending">En attente du client</option>
                                                                            <option value="close">Fermer le ticket</option>
                                                                        </select>
                                                                    </div>
                                                                    <div class="col-md-6 text-end">
                                                                        <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2" style="background-color: #4f46e5; border-color: #4f46e5;">
                                                                            <i class="fa-solid fa-paper-plane"></i>
                                                                            <span>Envoyer la réponse</span>
                                                                        </button>
                                                                    </div>
                                                                </div>
                                                            </form>
                                                        </div>
                                                        <div class="modal-footer border-top bg-light">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="6" class="text-center text-muted py-4">
                                                <i class="fa-solid fa-ticket me-2"></i>Aucun ticket de support pour le moment.
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <% } else { %>
