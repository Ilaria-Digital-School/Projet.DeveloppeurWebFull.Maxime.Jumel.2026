                            <input type="file" class="form-control" id="account-profile-pic" name="avatar" accept=".webp,image/webp">
                        </div>
                    </div>
                    <div class="modal-footer border-top bg-light">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                        <button type="submit" class="btn btn-primary d-flex align-items-center gap-2" style="background-color: #4f46e5; border-color: #4f46e5;">
                            <i class="fa-solid fa-floppy-disk"></i>
                            <span>Enregistrer</span>
                        </button>
                    </div>
                </form>
