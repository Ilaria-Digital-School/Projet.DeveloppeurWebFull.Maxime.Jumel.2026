                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="account-password" class="form-label fw-semibold">Nouveau mot de passe (laisser vide pour ne pas changer)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa-solid fa-lock text-muted"></i></span>
                                <input type="password" class="form-control" id="account-password" name="password" placeholder="•••••••• (min 6 car.)">
                            </div>
                        </div>
                        <div class="mb-3">
