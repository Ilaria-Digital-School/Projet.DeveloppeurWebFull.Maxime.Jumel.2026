                <div class="col-12 col-md-4">
                    <div class="card border-0 shadow-sm h-100" style="border-radius: 0.75rem;">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-3" style="width: 3rem; height: 3rem; display: flex; align-items: center; justify-content: center;">
                                    <i class="fa-solid fa-diagram-project fs-5"></i>
                                </div>
                                <span class="badge bg-primary bg-opacity-10 text-primary fw-medium">Actif</span>
                            </div>
                            <span class="text-muted d-block mb-1" style="font-size: 0.85rem; font-weight: 500;">Mes Projets en cours</span>
                            <p class="fs-3 fw-bold mb-0 text-dark"><%= (typeof prj !== 'undefined') ? (prj.length || prj) : (user?.prj || 0) %></p>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="card border-0 shadow-sm h-100" style="border-radius: 0.75rem;">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="bg-success bg-opacity-10 text-success p-3 rounded-3" style="width: 3rem; height: 3rem; display: flex; align-items: center; justify-content: center;">
                                    <i class="fa-solid fa-bag-shopping fs-5"></i>
                                </div>
                                <span class="badge bg-success bg-opacity-10 text-success fw-medium">Validé</span>
                            </div>
                            <span class="text-muted d-block mb-1" style="font-size: 0.85rem; font-weight: 500;">Mes Commandes</span>
                            <p class="fs-3 fw-bold mb-0 text-dark">2</p>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="card border-0 shadow-sm h-100" style="border-radius: 0.75rem;">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="bg-info bg-opacity-10 text-info p-3 rounded-3" style="width: 3rem; height: 3rem; display: flex; align-items: center; justify-content: center;">
                                    <i class="fa-solid fa-headset fs-5"></i>
                                </div>
                                <span class="badge bg-info bg-opacity-10 text-info fw-medium">En ligne</span>
                            </div>
                            <span class="text-muted d-block mb-1" style="font-size: 0.85rem; font-weight: 500;">Support Client</span>
                            <p class="fs-3 fw-bold mb-0 text-dark">Disponible</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Client Orders & Projects List -->
            <div class="row g-4 mb-4">
                <div class="col-12 col-xl-8">
                    <div class="card border-0 shadow-sm p-4" style="border-radius: 0.75rem;">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h2 class="h5 fw-bold text-dark mb-0">Mes Commandes & Projets</h2>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr style="font-size: 0.85rem; color: #6b7280;">
                                        <th scope="col">Référence</th>
                                        <th scope="col">Prestation</th>
                                        <th scope="col">Date</th>
                                        <th scope="col">Statut</th>
                                        <th scope="col">Montant</th>
                                    </tr>
                                </thead>
                                <tbody style="font-size: 0.9rem;">
                                    <% if (typeof orders !== 'undefined' && orders.length > 0) { %>
                                        <% orders.forEach(order => { %>
                                            <tr>
                                                <td class="fw-semibold">#CMD-<%= order.id %></td>
                                                <td><%= order.name %></td>
                                                <td class="text-muted"><%= new Date(order.created_at || Date.now()).toLocaleDateString('fr-FR') %></td>
                                                <td>
                                                    <% if (order.status === 'Complété') { %>
                                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2.5 py-1">Terminé</span>
                                                    <% } else if (order.status === 'En cours') { %>
                                                        <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-2.5 py-1">En cours</span>
                                                    <% } else if (order.status === 'Annulé') { %>
                                                        <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-2.5 py-1">Annulé</span>
                                                    <% } else { %>
                                                        <span class="badge bg-info bg-opacity-10 text-info rounded-pill px-2.5 py-1"><%= order.status %></span>
                                                    <% } %>
                                                </td>
                                                <td class="fw-semibold"><%= Number(order.total_price || 0).toLocaleString('fr-FR', { minimumFractionDigits: 2 }) %> €</td>
                                            </tr>
                                        <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="5" class="text-center text-muted py-4">Vous n'avez aucune commande pour le moment.</td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-xl-4">
                    <div class="card border-0 shadow-sm p-4 h-100" style="border-radius: 0.75rem;">
                        <h2 class="h5 fw-bold text-dark mb-1">Besoin d'aide ?</h2>
                        <p class="text-muted mb-4" style="font-size: 0.85rem;">Soumettez un ticket de support pour toute question concernant votre projet.</p>
                        <a href="/client/ticket" class="btn btn-primary w-100 d-flex align-items-center justify-content-center gap-2" style="background-color: #4f46e5; border-color: #4f46e5;">
                            <i class="fa-solid fa-ticket"></i>
                            <span>Gestion des tickets</span>
                        </a>

                        <% if (typeof tickets !== 'undefined' && tickets.length > 0) { %>
                        <hr class="my-4">
                        <h6 class="fw-bold text-dark mb-3" style="font-size:0.85rem;">Mes tickets récents</h6>
                        <div class="d-flex flex-column gap-2">
                            <% tickets.slice(0, 3).forEach(ticket => { %>
                            <div class="d-flex justify-content-between align-items-start p-2 rounded-2 bg-light">
                                <div>
                                    <p class="mb-0 fw-semibold" style="font-size:0.8rem;"><%= ticket.subject %></p>
                                    <small class="text-muted"><%= new Date(ticket.created_at).toLocaleDateString('fr-FR') %></small>
                                </div>
                                <% if (ticket.status === 'Répondu') { %>
                                    <span class="badge bg-success bg-opacity-10 text-success" style="font-size:0.7rem;">Répondu</span>
                                <% } else if (ticket.status === 'En cours') { %>
                                    <span class="badge bg-warning bg-opacity-10 text-warning" style="font-size:0.7rem;">En cours</span>
                                <% } else { %>
                                    <span class="badge bg-danger bg-opacity-10 text-danger" style="font-size:0.7rem;">Nouveau</span>
                                <% } %>
                            </div>
                            <% }); %>
                        </div>
                        <% } %>
                    </div>
                </div>
            </div>
            <% } %>
        </div>
    </main>

