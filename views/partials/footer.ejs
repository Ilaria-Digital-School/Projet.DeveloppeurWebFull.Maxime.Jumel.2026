<footer class="text-dark py-5" role="contentinfo">
  <div class="container">
    <div class="row gy-5">
      <div class="col-md-6">
        <h3 class="h4 fw-bold">
          Recevez nos conseils et actualités directement dans votre boîte mail
        </h3>
        <form class="mt-4" style="max-width: 25rem"  action="/subscribe" method="POST"  id="newsletter-form" autocomplete="off">
          <label for="newsletter-email" class="visually-hidden">Votre adresse email</label>
          <div class="d-flex align-items-center border-bottom border-dark pb-2">
            <input
              id="newsletter-email"
              name="email"
              type="email"
              class="form-control border-0 bg-transparent shadow-none px-0"
              placeholder="Votre adresse email"
              autocomplete="email"
              required>
            <button type="submit" class="btn p-0 ms-2" aria-label="S'inscrire à la newsletter">
              <i class="bi bi-arrow-up-right fs-4" aria-hidden="true"></i>
            </button>
          </div>
          <div class="form-check mt-3">
            <input class="form-check-input" type="checkbox" id="newsletter-consent" name="consent" value="1" required>
            <label class="form-check-label small" for="newsletter-consent">
              J'accepte de recevoir la newsletter de <%= legal.siteName %> par email. Je peux me désinscrire à tout moment. *
            </label>
          </div>
          <div id="newsletter-alert" class="mt-3" aria-live="polite"></div>
        </form>
        <p class="text-dark small mt-3 mb-0">
          Votre email sert uniquement à l'envoi de la newsletter (base légale : votre consentement). Voir la
          <a href="/confidentialite" class="text-dark text-decoration-underline">politique de confidentialité</a>.
        </p>
      </div>

      <div class="col-md-3 offset-md-3 mt-4 mt-md-0">
        <h4 class="h5 fw-bold">Links</h4>
        <ul class="list-unstyled mt-3">
          <li class="mb-2"><a href="/about" class="text-dark text-decoration-none">About</a></li>
          <li class="mb-2"><a href="/portfolio" class="text-dark text-decoration-none">Portfolios</a></li>
          <li class="mb-2"><a href="/project" class="text-dark text-decoration-none">Project</a></li>
          <li class="mb-2"><a href="/blog" class="text-dark text-decoration-none">Blog</a></li>
          <li class="mb-2"><a href="/contact" class="text-dark text-decoration-none">Contact</a></li>
          <li class="mb-2"><a href="/register" class="text-dark text-decoration-none">register</a></li>
          <li class="mb-2"><a href="/login" class="text-dark text-decoration-none">login</a></li>
        </ul>
      </div>
    </div>

    <div class="row mt-5">
      <div class="col-md-6">
        <h4 class="h5 fw-bold">Contact</h4>
        <p class="mt-3 mb-1"><%= legal.address %></p>
        <a href="tel:<%= legal.phone.replace(/\s/g, '') %>" class="d-block text-dark text-decoration-none mb-1"><%= legal.phone %></a>
        <a href="mailto:<%= legal.email %>" class="d-block text-dark text-decoration-none"><%= legal.email %></a>
      </div>
    </div>

    <hr class="border-dark mt-5">

    <div class="row align-items-center pt-3">
      <div class="col-6">
        <p class="mb-2">© <%= new Date().getFullYear() %> <%= legal.siteName %> - <%= legal.publisherName %></p>
        <nav aria-label="Informations légales">
          <ul class="list-inline mb-0 small">
            <li class="list-inline-item"><a href="/mentions-legales" class="text-dark">Mentions légales</a></li>
            <li class="list-inline-item"><a href="/confidentialite" class="text-dark">Confidentialité</a></li>
            <li class="list-inline-item"><a href="/cookies" class="text-dark">Cookies</a></li>
            <li class="list-inline-item"><a href="/cgv" class="text-dark">CGV</a></li>
            <li class="list-inline-item"><a href="/cgu" class="text-dark">CGU</a></li>
            <li class="list-inline-item"><button type="button" class="btn btn-link btn-sm p-0 text-dark align-baseline" data-cookie-settings>Gérer mes cookies</button></li>
          </ul>
        </nav>
      </div>
      <div class="col-6 text-end">
        <a href="https://facebook.com" class="text-dark mx-2" aria-label="Facebook" target="_blank" rel="noopener noreferrer"><i class="bi bi-facebook fs-5" aria-hidden="true"></i></a>
        <a href="https://instagram.com" class="text-dark mx-2" aria-label="Instagram" target="_blank" rel="noopener noreferrer"><i class="bi bi-instagram fs-5" aria-hidden="true"></i></a>
        <a href="https://x.com" class="text-dark mx-2" aria-label="X / Twitter" target="_blank" rel="noopener noreferrer"><i class="bi bi-twitter-x fs-5" aria-hidden="true"></i></a>
        <a href="https://dribbble.com" class="text-dark mx-2" aria-label="Dribbble" target="_blank" rel="noopener noreferrer"><i class="bi bi-dribbble fs-5" aria-hidden="true"></i></a>
      </div>
    </div>
  </div>
</footer>
