<!doctype html>
<html lang="fr">
  <%- include("partials/head", { title: "Mot de passe oublié | Souflydev", description: "Réinitialisez le mot de passe de votre compte Souflydev en recevant un lien sécurisé par email.", canonical: "https://soulfyhub.fr/forgot-password", social: false, styles: ["/css/_login.css"], language: "French" }) %>
  <body class="bg-black d-flex flex-column align-items-center justify-content-center min-vh-100 py-4">
    <div class="login-container">
      <div class="mb-4">
        <a href="/login" class="back-link">
          <i class="bi bi-arrow-left"></i> Retour à la connexion
        </a>
      </div>

      <main class="login-card text-center">
        <div class="mb-4">
          <img
            src="/images/upload/soulfydev.webp"
            class="brand-logo mb-3"
            alt="Soulfydev Logo">
          <h1 class="h3 font-weight-bold text-light mb-1">Mot de passe oublié</h1>
          <p class="text-light small pt-3 mb-0">
            Indiquez l'adresse email de votre compte : nous vous enverrons un lien
            pour choisir un nouveau mot de passe.
          </p>
        </div>

        <% if (sent) { %>
          <div class="alert alert-info py-2 px-3 small text-start" role="status">
            <i class="bi bi-envelope-check me-1" aria-hidden="true"></i>
            <%= message %>
          </div>
          <p class="small text-secondary mt-3 mb-0">
            Pensez à vérifier vos courriers indésirables.
          </p>
        <% } else { %>
          <form id="forgotPasswordForm" novalidate>
            <label
              for="inputEmail"
              class="form-label text-light small font-weight-bold text-start d-block"
            >Adresse Email</label>
            <input
              type="email"
              class="form-control form-control-custom"
              id="inputEmail"
              placeholder="nom@exemple.com"
              aria-label="Adresse Email"
              autocomplete="email"
              required>
            <button
              type="submit"
              id="btnSubmit"
              class="btn btn-login btn-primary w-100 text-light uppercase mt-4"
            >Envoyer le lien</button>
          </form>
        <% } %>
      </main>

      <footer class="text-center mt-4">
        <p class="text-secondary small mb-0">Powered by Souflydev</p>
      </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"></script>
    <script src="/js/password-reset.js"></script>
    <%- include("partials/cookie-consent") %>
  </body>
</html>