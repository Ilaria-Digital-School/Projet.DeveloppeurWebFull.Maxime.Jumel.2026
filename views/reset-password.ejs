<!doctype html>
<html lang="fr">
  <%- include("partials/head", { title: "Nouveau mot de passe | Souflydev", description: "Choisissez un nouveau mot de passe pour votre compte Souflydev.", canonical: "https://soulfyhub.fr/reset-password", social: false, styles: ["/css/_login.css"], language: "French" }) %>
  <body class="bg-black d-flex flex-column align-items-center justify-content-center min-vh-100 py-4">
    <div class="login-container">
      <div class="mb-4">
        <a href="/login" class="back-link">
          <i class="bi bi-arrow-left"></i> Retour à la connexion
        </a>
      </div>

      <main class="login-card text-center">
        <div class="mb-4">
          <img
            src="/images/upload/soulfydev.webp"
            class="brand-logo mb-3"
            alt="Soulfydev Logo">

          <% if (message) { %>
            <h1 class="h3 font-weight-bold text-light mb-3">Mot de passe mis à jour</h1>
            <div class="alert alert-success py-2 px-3 small text-start" role="status">
              <i class="bi bi-check-circle-fill me-1" aria-hidden="true"></i>
              <%= message %>
            </div>
            <a href="/login" class="back-link mt-3 d-inline-block">Se connecter</a>

          <% } else if (!valid) { %>
            <h1 class="h3 font-weight-bold text-light mb-3">Lien invalide</h1>
            <div class="alert alert-danger py-2 px-3 small text-start" role="alert">
              <i class="bi bi-exclamation-circle-fill me-1" aria-hidden="true"></i>
              <%= error %>
            </div>
            <a href="/forgot-password" class="back-link mt-3 d-inline-block">Demander un nouveau lien</a>

          <% } else { %>
            <h1 class="h3 font-weight-bold text-light mb-1">Nouveau mot de passe</h1>
            <p class="text-light small pt-3 mb-0">
              Choisissez un mot de passe d'au moins 6 caractères, avec une majuscule,
              une minuscule, un chiffre et un caractère spécial.
            </p>

            <% if (error) { %>
              <div class="alert alert-danger py-2 px-3 small text-start" role="alert">
                <i class="bi bi-exclamation-circle-fill me-1" aria-hidden="true"></i>
                <%= error %>
              </div>
            <% } %>

            <form id="resetPasswordForm" data-token="<%= token %>" novalidate>
              <label
                for="inputPassword"
                class="form-label text-light small font-weight-bold text-start d-block mt-3"
              >Nouveau mot de passe</label>
              <input
                type="password"
                class="form-control form-control-custom"
                id="inputPassword"
                placeholder="••••••••"
                aria-label="Nouveau mot de passe"
                autocomplete="new-password"
                required>

              <label
                for="inputConfirmation"
                class="form-label text-light small font-weight-bold text-start d-block mt-3"
              >Confirmer le mot de passe</label>
              <input
                type="password"
                class="form-control form-control-custom"
                id="inputConfirmation"
                placeholder="••••••••"
                aria-label="Confirmation du mot de passe"
                autocomplete="new-password"
                required>

              <button
                type="submit"
                id="btnSubmit"
                class="btn btn-login btn-primary w-100 text-light uppercase mt-4"
              >Mettre à jour</button>
            </form>
          <% } %>
        </div>
      </main>

      <footer class="text-center mt-4">
        <p class="text-secondary small mb-0">Powered by Souflydev</p>
      </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"></script>
    <script src="/js/password-reset.js"></script>
    <%- include("partials/cookie-consent") %>
  </body>
</html>