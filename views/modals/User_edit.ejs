<!-- Modal : Édition d'un utilisateur -->
<div class="modal fade" id="modalUserEdit" tabindex="-1" aria-labelledby="modalUserEditLabel" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg">

            <!-- Header -->
            <div class="modal-header text-white" style="background: linear-gradient(135deg, #1e1e24 0%, #111215 100%); border-bottom: 1px solid rgba(255,255,255,0.08);">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center shadow-sm"
                         style="width: 2.75rem; height: 2.75rem; background: rgba(99, 102, 241, 0.2); border: 1px solid rgba(99, 102, 241, 0.4);">
                        <i class="fa-solid fa-user-pen text-indigo fs-5" style="color: #818cf8;"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h5 class="modal-title fw-bold mb-0 text-white" id="modalUserEditLabel">
                                Modifier l'utilisateur
                            </h5>
                            <span id="editUserBadgeRole" class="badge rounded-pill" style="font-size: 0.72rem;"></span>
                        </div>
                        <small class="text-white-50">
                            ID : <code id="editUserDisplayId" class="text-info-emphasis" style="font-size: 0.78rem;">—</code>
                        </small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>

            <!-- Formulaire -->
            <form id="formUserEdit" method="POST" action="/api/admin/users/update">
                <input type="hidden" name="userId" id="editUserId">

                <div class="modal-body p-4" style="background-color: #fbfbfd;">
                    
                    <!-- Alert message container -->
                    <div id="editUserAlert" class="alert d-none mb-3 py-2 px-3 small" role="alert"></div>

                    <!-- En-tête profil rapide avec aperçu d'avatar -->
                    <div class="card border-0 shadow-sm p-3 mb-4" style="background: #ffffff; border-radius: 12px;">
                        <div class="d-flex align-items-center gap-3">
                            <div class="position-relative">
                                <img id="editUserAvatarPreview"
                                     src="https://i.pravatar.cc/80"
                                     alt="Aperçu avatar"
                                     class="rounded-circle shadow-sm border border-2 border-primary border-opacity-25"
                                     style="width: 64px; height: 64px; object-fit: cover;">
                            </div>
                            <div class="flex-grow-1">
                                <label for="editUserAvatar" class="form-label fw-semibold small text-muted mb-1">
                                    <i class="fa-solid fa-image me-1"></i>URL de l'avatar
                                </label>
                                <input type="url" class="form-control form-control-sm" id="editUserAvatar" name="avatar"
                                       placeholder="https://example.com/avatar.jpg">
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <!-- Section 1 : Informations principales -->
                        <div class="col-12">
                            <h6 class="text-uppercase text-muted fw-bold mb-2" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                                <i class="fa-solid fa-id-card me-1 text-primary"></i>Informations personnelles
                            </h6>
                        </div>

                        <!-- Pseudo -->
                        <div class="col-md-6">
                            <label for="editUserPseudo" class="form-label fw-semibold small">Pseudo <span class="text-danger">*</span></label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white"><i class="fa-solid fa-user text-muted"></i></span>
                                <input type="text" class="form-control" id="editUserPseudo" name="pseudo" required maxlength="50">
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="col-md-6">
                            <label for="editUserEmail" class="form-label fw-semibold small">Adresse Email <span class="text-danger">*</span></label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white"><i class="fa-solid fa-envelope text-muted"></i></span>
                                <input type="email" class="form-control" id="editUserEmail" name="email" required>
                            </div>
                        </div>

                        <!-- Section 2 : Rôle et Statut -->
                        <div class="col-12 mt-3">
                            <h6 class="text-uppercase text-muted fw-bold mb-2" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                                <i class="fa-solid fa-user-shield me-1 text-primary"></i>Rôle & Autorisations
                            </h6>
                        </div>

                        <!-- Rôle -->
                        <div class="col-md-6">
                            <label for="editUserRole" class="form-label fw-semibold small">Rôle</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white"><i class="fa-solid fa-shield-halved text-muted"></i></span>
                                <select class="form-select" id="editUserRole" name="role">
                                    <option value="user">Utilisateur (Client)</option>
                                    <option value="developper">Développeur</option>
                                    <option value="admin">Administrateur</option>
                                </select>
                            </div>
                        </div>

                        <!-- Statut -->
                        <div class="col-md-6">
                            <label for="editUserStatus" class="form-label fw-semibold small">Statut du compte</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white"><i class="fa-solid fa-toggle-on text-muted"></i></span>
                                <select class="form-select" id="editUserStatus" name="status">
                                    <option value="active">Actif</option>
                                    <option value="inactive">Inactif</option>
                                </select>
                            </div>
                        </div>

                        <!-- Section 3 : Finances & Métriques -->
                        <div class="col-12 mt-3">
                            <h6 class="text-uppercase text-muted fw-bold mb-2" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                                <i class="fa-solid fa-wallet me-1 text-primary"></i>Solde & Crédits
                            </h6>
                        </div>

                        <div class="col-md-6">
                            <label for="editUserSolde" class="form-label fw-semibold small">Solde (€)</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white"><i class="fa-solid fa-euro-sign text-muted"></i></span>
                                <input type="number" step="0.01" min="0" class="form-control" id="editUserSolde" name="solde" value="0">
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label for="editUserCredits" class="form-label fw-semibold small">Crédits</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white"><i class="fa-solid fa-coins text-muted"></i></span>
                                <input type="number" min="0" class="form-control" id="editUserCredits" name="credits" value="0">
                            </div>
                        </div>

                        <!-- Section 4 : Sécurité & Restrictions -->
                        <div class="col-12 mt-3">
                            <h6 class="text-uppercase text-muted fw-bold mb-2" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                                <i class="fa-solid fa-lock me-1 text-primary"></i>Sécurité & Modération
                            </h6>
                        </div>

                        <!-- Email vérifié -->
                        <div class="col-md-6">
                            <div class="card h-100 border-0 shadow-sm p-3" style="background:#ffffff; border-radius:10px;">
                                <div class="form-check form-switch d-flex align-items-center justify-content-between p-0 m-0">
                                    <div>
                                        <label class="form-check-label fw-semibold small d-block" for="editUserVerified">Email vérifié</label>
                                        <small class="text-muted" style="font-size: 0.75rem;">Permet de valider manuellement l'email</small>
                                    </div>
                                    <input class="form-check-input ms-2" type="checkbox" role="switch" id="editUserVerified" name="emailVerified" value="true">
                                </div>
                            </div>
                        </div>

                        <!-- Banni -->
                        <div class="col-md-6">
                            <div class="card h-100 border-0 shadow-sm p-3" style="background:#ffffff; border-radius:10px;">
                                <div class="form-check form-switch d-flex align-items-center justify-content-between p-0 m-0">
                                    <div>
                                        <label class="form-check-label fw-semibold small text-danger d-block" for="editUserBan">Bloquer / Bannir</label>
                                        <small class="text-muted" style="font-size: 0.75rem;">Coupe l'accès et ferme les sessions ouvertes</small>
                                    </div>
                                    <input class="form-check-input ms-2" type="checkbox" role="switch" id="editUserBan" name="isBan" value="true">
                                </div>

                                <div class="mt-3 d-none" id="editUserBanReasonWrap">
                                    <label for="editUserBanReason" class="form-label fw-semibold small mb-1">Motif du bannissement</label>
                                    <textarea class="form-control form-control-sm" id="editUserBanReason" name="banReason"
                                              rows="2" maxlength="300"
                                              placeholder="Expliqué à l'utilisateur sur la page de suspension"></textarea>
                                </div>
                            </div>
                        </div>

                        <!-- Nouveau mot de passe (optionnel) -->
                        <div class="col-12 mt-2">
                            <label for="editUserPassword" class="form-label fw-semibold small">
                                Réinitialiser le mot de passe <span class="text-muted fw-normal">(laisser vide pour ne pas modifier)</span>
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white"><i class="fa-solid fa-key text-muted"></i></span>
                                <input type="password" class="form-control" id="editUserPassword" name="password" placeholder="Nouveau mot de passe (min 6 car.)" autocomplete="new-password">
                                <button class="btn btn-outline-secondary" type="button" data-action="toggle-password" data-target="editUserPassword">
                                    <i class="fa-solid fa-eye"></i>
                                </button>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Footer -->
                <div class="modal-footer bg-white border-top px-4 py-3 justify-content-between">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">
                        <i class="fa-solid fa-xmark me-1"></i>Annuler
                    </button>
                    <button type="submit" id="btnSaveUserEdit" class="btn btn-primary btn-sm px-4 d-flex align-items-center gap-2" style="background-color: #4f46e5; border-color: #4f46e5;">
                        <i class="fa-solid fa-floppy-disk"></i>
                        <span>Enregistrer les modifications</span>
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

<script nonce="<%= cspNonce %>">
// Les actions sont câblées ici : la CSP interdit les attributs on* inline.
document.addEventListener('DOMContentLoaded', () => {
    const avatarInput = document.getElementById('editUserAvatar');
    if (avatarInput) avatarInput.addEventListener('input', () => previewEditAvatar(avatarInput.value));

    document.addEventListener('click', function (event) {
        const trigger = event.target.closest('[data-action="toggle-password"]');
        if (!trigger) return;
        togglePasswordVisibility(trigger.getAttribute('data-target'), trigger);
    });

    // Le motif n'a de sens que pour un compte banni.
    const banSwitch = document.getElementById('editUserBan');
    const banReasonWrap = document.getElementById('editUserBanReasonWrap');
    const toggleBanReason = () => {
        if (banSwitch && banReasonWrap) {
            banReasonWrap.classList.toggle('d-none', !banSwitch.checked);
        }
    };
    if (banSwitch) banSwitch.addEventListener('change', toggleBanReason);
    document.getElementById('modalUserEdit')?.addEventListener('hidden.bs.modal', toggleBanReason);
});

// Prévisualisation de l'avatar en temps réel
function previewEditAvatar(url) {
    const preview = document.getElementById('editUserAvatarPreview');
    if (!preview) return;
    if (url && url.trim().length > 0) {
        preview.src = url.trim();
    } else {
        const id = document.getElementById('editUserId')?.value || 'default';
        preview.src = 'https://i.pravatar.cc/80?u=' + encodeURIComponent(id);
    }
}

// Bascule d'affichage du mot de passe
function togglePasswordVisibility(inputId, btn) {
    const input = document.getElementById(inputId);
    if (!input) return;
    const isPassword = input.type === 'password';
    input.type = isPassword ? 'text' : 'password';
    const icon = btn.querySelector('i');
    if (icon) {
        icon.className = isPassword ? 'fa-solid fa-eye-slash' : 'fa-solid fa-eye';
    }
}

// Initialisation et remplissage lors de l'ouverture du modal
document.addEventListener('DOMContentLoaded', () => {
    const modalEl = document.getElementById('modalUserEdit');
    if (!modalEl) return;

    // Bootstrap 5.3 emet `show.bs.modal` avec `relatedTarget: this._element` (le modal
    // lui-meme), jamais avec le bouton declencheur. On memorise donc le bouton au clic,
    // en phase de capture afin de passer avant le gestionnaire data-api de Bootstrap.
    let lastTrigger = null;
    document.addEventListener('click', function (event) {
        const trigger = event.target.closest('[data-bs-target="#modalUserEdit"]');
        if (trigger) lastTrigger = trigger;
    }, true);

    modalEl.addEventListener('show.bs.modal', function (event) {
        const button = (lastTrigger && lastTrigger.getAttribute('data-user-id'))
            ? lastTrigger
            : event.relatedTarget;

        if (!button || !button.getAttribute('data-user-id')) return;

        const id       = button.getAttribute('data-user-id') || '';
        const pseudo   = button.getAttribute('data-user-pseudo') || '';
        const email    = button.getAttribute('data-user-email') || '';
        const role     = button.getAttribute('data-user-role') || 'user';
        const status   = button.getAttribute('data-user-status') || 'inactive';
        const verified = button.getAttribute('data-user-verified') === 'true';
        const ban      = button.getAttribute('data-user-ban') === 'true';
        const banReason = button.getAttribute('data-user-ban-reason') || '';
        const solde    = button.getAttribute('data-user-solde') || '0';
        const credits  = button.getAttribute('data-user-credits') || '0';
        const avatar   = button.getAttribute('data-user-avatar') || '';

        // Remplissage des champs
        document.getElementById('editUserId').value = id;
        document.getElementById('editUserDisplayId').textContent = id || '—';
        document.getElementById('editUserPseudo').value = pseudo;
        document.getElementById('editUserEmail').value = email;
        document.getElementById('editUserRole').value = role;
        document.getElementById('editUserStatus').value = status;
        document.getElementById('editUserSolde').value = solde;
        document.getElementById('editUserCredits').value = credits;
        document.getElementById('editUserAvatar').value = avatar;
        document.getElementById('editUserVerified').checked = verified;
        document.getElementById('editUserBan').checked = ban;
        document.getElementById('editUserBanReason').value = banReason;
        document.getElementById('editUserBanReasonWrap').classList.toggle('d-none', !ban);
        document.getElementById('editUserPassword').value = '';

        // Badge de rôle dans le header
        const badge = document.getElementById('editUserBadgeRole');
        if (badge) {
            badge.textContent = role.toUpperCase();
            if (role === 'admin') {
                badge.className = 'badge rounded-pill bg-danger';
            } else if (role === 'developper') {
                badge.className = 'badge rounded-pill bg-primary';
            } else {
                badge.className = 'badge rounded-pill bg-secondary';
            }
        }

        previewEditAvatar(avatar);

        // Réinitialiser les messages d'alerte
        const alertEl = document.getElementById('editUserAlert');
        if (alertEl) {
            alertEl.classList.add('d-none');
            alertEl.textContent = '';
        }
    });

    // Gestion de la soumission AJAX avec feedback fluide
    const form = document.getElementById('formUserEdit');
    if (form) {
        form.addEventListener('submit', async function (e) {
            e.preventDefault();
            const submitBtn = document.getElementById('btnSaveUserEdit');
            const alertEl = document.getElementById('editUserAlert');

            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Enregistrement...';
            }

            const formData = new FormData(form);
            const payload = {
                userId: formData.get('userId'),
                pseudo: formData.get('pseudo'),
                email: formData.get('email'),
                role: formData.get('role'),
                status: formData.get('status'),
                solde: formData.get('solde'),
                credits: formData.get('credits'),
                avatar: formData.get('avatar'),
                emailVerified: document.getElementById('editUserVerified').checked,
                isBan: document.getElementById('editUserBan').checked,
                banReason: document.getElementById('editUserBanReason')?.value || '',
                password: formData.get('password') || ''
            };

            try {
                const response = await fetch('/api/admin/users/update', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                const data = await response.json();

                if (response.ok && data.success) {
                    if (alertEl) {
                        alertEl.className = 'alert alert-success mb-3 py-2 px-3 small';
                        alertEl.textContent = data.message || 'Utilisateur mis à jour avec succès !';
                        alertEl.classList.remove('d-none');
                    }
                    setTimeout(() => {
                        window.location.reload();
                    }, 800);
                } else {
                    if (alertEl) {
                        alertEl.className = 'alert alert-danger mb-3 py-2 px-3 small';
                        alertEl.textContent = data.message || 'Une erreur est survenue lors de la mise à jour.';
                        alertEl.classList.remove('d-none');
                    }
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = '<i class="fa-solid fa-floppy-disk me-1"></i>Enregistrer les modifications';
                    }
                }
            } catch (err) {
                if (alertEl) {
                    alertEl.className = 'alert alert-danger mb-3 py-2 px-3 small';
                    alertEl.textContent = 'Erreur réseau lors de la communication avec le serveur.';
                    alertEl.classList.remove('d-none');
                }
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="fa-solid fa-floppy-disk me-1"></i>Enregistrer les modifications';
                }
            }
        });
    }
});
</script>
