<div class="modal fade" id="modalProjectAdmin" tabindex="-1" aria-labelledby="modalProjectAdminLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h2 class="modal-title h5" id="modalProjectAdminLabel">Créer un contenu portfolio</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <form id="projectAdminForm" action="/projects" method="POST" enctype="multipart/form-data">
                <div class="modal-body">
                    <div id="projectFormAlert" class="alert d-none" role="alert"></div>
                    <div class="mb-3">
                        <label for="project-admin-title" class="form-label">Titre</label>
                        <input id="project-admin-title" name="title" class="form-control" maxlength="160" required>
                    </div>
                    <div class="mb-3">
                        <label for="project-admin-description" class="form-label">Description</label>
                        <textarea id="project-admin-description" name="description" class="form-control" rows="5" maxlength="5000" required></textarea>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="project-admin-category">Catégorie</label>
                            <select id="project-admin-category" name="category" class="form-select">
                                <option value="">Aucune catégorie</option>
                                <% (typeof categories !== 'undefined' ? categories : []).forEach((category) => { %>
                                    <option value="<%= category.name %>"><%= category.name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="project-admin-tags">Tags <span class="text-muted small">(séparés par des virgules, 10 max)</span></label>
                            <input id="project-admin-tags" name="tags" class="form-control" placeholder="react, node, seo">
                        </div>
                        <div class="col-md-6"><label class="form-label" for="project-admin-type">Type</label><input id="project-admin-type" name="projectType" class="form-control"></div>
                        <div class="col-md-6"><label class="form-label" for="project-admin-client">Client</label><input id="project-admin-client" name="client" class="form-control"></div>
                        <div class="col-md-6"><label class="form-label" for="project-admin-location">Lieu</label><input id="project-admin-location" name="location" class="form-control"></div>
                        <div class="col-md-6"><label class="form-label" for="project-admin-budget">Budget</label><input id="project-admin-budget" name="budget" class="form-control"></div>
                        <div class="col-md-6"><label class="form-label" for="project-admin-duration">Durée</label><input id="project-admin-duration" name="duration" class="form-control"></div>
                        <div class="col-md-6"><label class="form-label" for="project-admin-image">Image <span class="text-muted small" id="projectImageHint"></span></label><input id="project-admin-image" name="image" type="file" class="form-control" accept="image/jpeg,image/png,image/webp"></div>
                    </div>
                    <div class="mt-3">
                        <label for="project-admin-result" class="form-label">Résultat final</label>
                        <textarea id="project-admin-result" name="result" class="form-control" rows="3" maxlength="3000"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary" id="projectAdminSubmit">Créer le contenu</button>
                </div>
            </form>
        </div>
    </div>
</div>
<script nonce="<%= locals.cspNonce || '' %>">
document.addEventListener("DOMContentLoaded", () => {
    const modal = document.getElementById("modalProjectAdmin");
    const form = document.getElementById("projectAdminForm");
    if (!modal || !form) return;
    // champ du formulaire -> clé data-project-* (camelCase)
    const fields = {
        title: "title", description: "description", category: "category", tags: "tags",
        projectType: "type", client: "client", location: "location",
        budget: "budget", duration: "duration", result: "result"
    };
    const alertBox = document.getElementById("projectFormAlert");
    const submit = document.getElementById("projectAdminSubmit");
    modal.addEventListener("show.bs.modal", (event) => {
        const trigger = event.relatedTarget;
        const editing = trigger?.dataset.projectAction === "edit";
        form.reset();
        form.dataset.editId = editing ? trigger.dataset.projectId : "";
        alertBox.className = "alert d-none";
        for (const [name, key] of Object.entries(fields)) {
            const dataKey = "project" + key[0].toUpperCase() + key.slice(1);
            form.elements[name].value = editing ? (trigger.dataset[dataKey] || "") : "";
        }
        document.getElementById("projectImageHint").textContent = editing ? "(vide = conserver l'actuelle)" : "";
        document.getElementById("modalProjectAdminLabel").textContent = editing ? "Modifier le projet" : "Créer un contenu portfolio";
        submit.textContent = editing ? "Enregistrer les modifications" : "Créer le contenu";
    });
    form.addEventListener("submit", async (event) => {
        const id = form.dataset.editId;
        if (!id) return;
        event.preventDefault();
        submit.disabled = true;
        try {
            const response = await fetch(`/projects/${encodeURIComponent(id)}`, {
                method: "PUT", body: new FormData(form), headers: { Accept: "application/json" }
            });
            const data = await response.json();
            if (!response.ok) throw new Error(data.message || "Modification impossible.");
            window.location.reload();
        } catch (error) {
            submit.disabled = false;
            alertBox.className = "alert alert-danger";
            alertBox.textContent = error.message;
        }
    });
});
</script>
